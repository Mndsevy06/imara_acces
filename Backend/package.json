{
  "name": "imara-access-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "build": "next build",
    "start": "dotenv -e .env -- tsx src/server.ts",
    "next:dev": "dotenv -e .env -- next dev",
    "next:start": "dotenv -e .env -- next start",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "server": "dotenv -e .env -- tsx src/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bonjour-service": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.2.6",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
